+/* ══════════════════════════════════════════════════════════
+   PRINT — hide persistent app chrome on every dashboard page
+   Sidebar/topbar are position:fixed siblings of routed content
+   (see main-layout.component.html), so a component-scoped
+   @media print block (e.g. report-preview.component.css) can
+   never reach them under ViewEncapsulation. This global,
+   unencapsulated rule is the only place that can hide them.
+   ══════════════════════════════════════════════════════════ */
+@media print {
+  .pc-sidebar,
+  .pc-topbar {
+    display: none !important;
+  }
+  .pc-container {
+    margin-left: 0 !important;
+    margin-top: 0 !important;
+  }
+
+  /* Clinically meaningful color coding (result flags, alerts,
+     worklist status) must survive print/PDF drivers that strip
+     background colors by default (notably Firefox). */
+  .lis-flag,
+  .status-icon,
+  .wl-dot,
+  .alert-dot,
+  .pill--stat,
+  .pill--routine,
+  [class*='flag-stat'] {
+    print-color-adjust: exact;
+    -webkit-print-color-adjust: exact;
+  }
+}
