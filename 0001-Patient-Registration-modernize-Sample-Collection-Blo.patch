-              <select id="bloodGroup" formControlName="bloodGroup">
+              <label id="bloodgroup-label">Blood Group <span class="opt-label">(Optional)</span></label>
+              <div class="bg-chip-group" role="group" aria-labelledby="bloodgroup-label">
                 @for (bg of bloodGroups; track bg) {
-                  <option [value]="bg">{{ bg }}</option>
+                  <button type="button" class="bg-chip"
+                    [class.bg-chip--active]="form.value.bloodGroup === bg"
+                    (click)="form.patchValue({bloodGroup: bg})"
+                    [attr.aria-pressed]="form.value.bloodGroup === bg">
+                    <i class="ti ti-droplet-filled bg-chip__icon" aria-hidden="true"></i>{{ bg }}
+                  </button>
                 }
-              </select>
+              </div>
             </div>
           </div>
         </div>
@@ -454,13 +462,28 @@
               </div>
             </div>
 
-            <!-- Sample collection -->
+            <!-- Sample collection — modernized from a native <select> to
+                 the same icon segmented-control pattern used for Visit
+                 type / Fasting status just above, instead of being the
+                 one legacy dropdown on this step. Icons intentionally
