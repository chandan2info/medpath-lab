From 4d97b78a76cbe7b35ad8bcfdf95fed6ec1da5b9a Mon Sep 17 00:00:00 2001
From: Chandan <chandan@medpath-lab.dev>
Date: Fri, 10 Jul 2026 19:49:33 +0000
Subject: [PATCH] Patient Registration: progress summary, address counter,
 cleanup

UX audit fixes for the Personal Details step:
- Add a live 'N of M required fields complete' progress bar
  under the Personal Details card header (Priority 22).
- Add a character counter (0/250) under the Address textarea,
  with maxlength enforcement and a near-limit warning color
  (Priority 10).
- Clearer Email placeholder ('name@email.com' instead of a
  filled-looking 'patient@email.com') so it doesn't read as
  a real pre-filled value (Priority 9).
- Removed leftover debug console.log statements from the DOB
  valueChanges subscription.

Note: header height, border density, gender/blood-group layout,
age-card design, and stepper coloring from the same audit were
already addressed in prior commits on this branch.
---
 .../patient-registration.component.css        | 52 +++++++++++++++
 .../patient-registration.component.html       | 18 ++++-
 .../patient-registration.component.ts         | 65 ++++++++++++++-----
 3 files changed, 117 insertions(+), 18 deletions(-)

diff --git a/src/app/features/patient-registration/patient-registration.component.css b/src/app/features/patient-registration/patient-registration.component.css
index 587aebb..2eb62b9 100644
--- a/src/app/features/patient-registration/patient-registration.component.css
+++ b/src/app/features/patient-registration/patient-registration.component.css
@@ -79,6 +79,58 @@
   border: 0;
 }
 
+/* ══════════════════════════════════════════════════════
+   REGISTRATION PROGRESS SUMMARY (Priority 22)
+   Slim bar + label under the Personal Details card header,
+   so the operator sees how much of the required data is
+   left without a heavier sticky sidebar.
+   ══════════════════════════════════════════════════════ */
+.reg-progress {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  padding: 10px 20px 0;
+}
+.reg-progress__bar {
+  flex: 1;
+  height: 5px;
+  border-radius: 3px;
+  background: var(--body-bg);
+  border: 0.5px solid var(--border-color);
+  overflow: hidden;
+}
+.reg-progress__fill {
+  height: 100%;
+  border-radius: 3px;
+  background: var(--lis-primary, #1D9E75);
+  transition: width 0.25s ease;
+}
+.reg-progress__label {
+  flex-shrink: 0;
+  display: flex;
+  align-items: center;
+  gap: 5px;
+  font-size: 11px;
+  font-weight: 500;
+  color: var(--text-secondary);
+  white-space: nowrap;
+  i { font-size: 13px; }
+}
+.reg-progress__label--done { color: var(--lis-primary, #1D9E75); }
+
+/* ══════════════════════════════════════════════════════
+   CHARACTER COUNTER (Priority 10 — Address field)
+   ══════════════════════════════════════════════════════ */
+.char-counter {
+  display: block;
+  align-self: flex-end;
+  font-size: 10.5px;
+  color: var(--text-secondary);
+  margin-top: 3px;
+  font-variant-numeric: tabular-nums;
+}
+.char-counter--near-limit { color: var(--lis-danger, #E24B4A); font-weight: 500; }
+
 /* ══════════════════════════════════════════════════════
    FIELD GROUPS — Identity / Contact / Address,
    Visit Details / Preparation / Medication
