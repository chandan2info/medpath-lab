   color: var(--lis-primary-deep, #085041);
   border-color: var(--lis-primary, #1D9E75);
   font-weight: 600;
+  box-shadow: inset 0 0 0 1px var(--lis-primary-mid, #5DCAA5);
   i { color: var(--lis-primary, #1D9E75); }
 }
+.gender-card--active:hover { transform: none; box-shadow: inset 0 0 0 1px var(--lis-primary-mid, #5DCAA5); }
 
 /* Textareas that grow with content instead of leaving a tall
    empty box; still resizable if the operator wants more room. */
 .auto-expand {
-  min-height: 44px !important;
+  min-height: 40px !important;
   height: auto;
   overflow-y: hidden;
+  border-radius: 9px;
 }
 
 /* ══════════════════════════════════════════════════════
@@ -498,7 +584,7 @@
   display: flex;
   align-items: center;
   gap: 12px;
-  padding: 12px 20px;
+  padding: 10px 20px;
   border-bottom: 0.5px solid var(--border-color);
   background: var(--lis-primary-xlight, #E1F5EE);
 }
