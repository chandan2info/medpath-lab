diff --git a/src/app/features/analytics/analytics.component.css b/src/app/features/analytics/analytics.component.css
new file mode 100644
index 0000000..3c1ed67
--- /dev/null
+++ b/src/app/features/analytics/analytics.component.css
@@ -0,0 +1,257 @@
+:host { display: block; }
+
+.page-header-actions { display: flex; gap: 8px; }
+
+/* ── Loading fade ─────────────────────────────────────────── */
+.an-fade { opacity: 0.5; pointer-events: none; transition: opacity 0.2s ease; }
+
+/* ── Date range bar ───────────────────────────────────────── */
+.an-range-bar {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  flex-wrap: wrap;
+  margin: 14px 0 16px;
+}
+.an-range-bar__spacer { flex: 1 1 auto; }
+
+.an-chip {
+  position: relative;
+  padding: 7px 16px;
+  min-height: 34px;
+  border-radius: 20px;
+  border: 0.5px solid var(--border-color);
+  background: var(--card-bg);
+  color: var(--text-secondary);
+  font-size: 12.5px;
+  font-weight: 500;
+  cursor: pointer;
+  overflow: hidden;
+  transition: color 0.15s ease, border-color 0.15s ease, background 0.18s ease, transform 0.12s ease;
+}
+.an-chip::before {
+  content: '';
+  position: absolute;
+  inset: 0;
+  border-radius: inherit;
+  background: rgba(99, 102, 241, 0.10); /* indigo hover wash — mirrors sidebar hover accent */
+  opacity: 0;
+  transition: opacity 0.15s ease;
+}
+.an-chip:hover {
+  color: var(--text-primary);
+  border-color: #6366F1;
+  transform: translateY(-1px);
+}
+.an-chip:hover::before { opacity: 1; }
+.an-chip:active { transform: translateY(0); }
+.an-chip--active {
+  color: #fff;
+  border-color: var(--lis-primary, #3DC9A8);
+  background: var(--lis-primary, #3DC9A8);
+  box-shadow: 0 0 0 3px rgba(61, 201, 168, 0.22); /* teal active glow — mirrors sidebar active state */
+}
+.an-chip--active::before { opacity: 0; }
+.an-chip--active:hover { color: #fff; border-color: var(--lis-primary, #3DC9A8); }
+
+.an-collect {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  padding: 7px 14px;
+  border-radius: 20px;
+  background: var(--body-bg);
+  border: 0.5px solid var(--border-color);
+  font-size: 12px;
+  color: var(--text-secondary);
+  transition: opacity 0.2s ease;
+}
+.an-collect i { color: var(--lis-primary, #3DC9A8); font-size: 14px; }
+.an-collect strong { color: var(--text-primary); font-weight: 600; }
+.an-collect__dues { color: #E24B4A; }
+.an-collect__sep { opacity: 0.5; }
+.an-collect--loading { opacity: 0.55; }
+
+/* ── KPI grid ─────────────────────────────────────────────── */
+.an-kpi-grid {
+  display: grid;
+  grid-template-columns: repeat(5, 1fr);
+  gap: 12px;
+  margin-bottom: 16px;
+}
+.an-kpi-card {
+  background: var(--card-bg);
+  border: 0.5px solid var(--border-color);
+  border-radius: var(--lis-card-radius, 10px);
+  padding: 14px 16px;
+  transition: box-shadow 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
+}
+.an-kpi-card:hover {
+  box-shadow: var(--shadow-card-hover, 0 12px 36px rgba(83,103,254,0.16));
+  border-color: rgba(99, 102, 241, 0.35);
+  transform: translateY(-2px);
+}
+.an-kpi-top { display: flex; align-items: flex-start; gap: 10px; position: relative; }
+.an-kpi-icon {
+  width: 34px; height: 34px; border-radius: 9px;
+  display: flex; align-items: center; justify-content: center;
+  font-size: 16px; flex: 0 0 auto;
+}
+.an-kpi-icon--primary { background: var(--lis-primary-xlight, #E8EBFF); color: var(--lis-primary, #3DC9A8); }
+.an-kpi-icon--accent  { background: rgba(83,103,254,0.10); color: #5367FE; }
+.an-kpi-icon--warning { background: #FAEEDA; color: #A9660C; }
+.an-kpi-icon--danger  { background: #FCEBEB; color: #C0392B; }
+.an-kpi-body { min-width: 0; flex: 1; }
+.an-kpi-label { font-size: 11.5px; color: var(--text-secondary); margin-bottom: 3px; }
+.an-kpi-value { font-size: 20px; font-weight: 600; color: var(--text-primary); line-height: 1.15; }
+.an-kpi-spark { width: 56px; height: 26px; flex: 0 0 auto; }
+.an-kpi-spark--primary polyline { stroke: var(--lis-primary, #3DC9A8); }
+.an-kpi-spark--accent  polyline { stroke: #5367FE; }
+.an-kpi-spark--warning polyline { stroke: #EF9F27; }
+.an-kpi-spark--danger  polyline { stroke: #E24B4A; }
+.an-kpi-delta { margin-top: 8px; font-size: 11px; }
+.an-kpi-delta--up      { color: #0F6E56; }
+.an-kpi-delta--down    { color: #C0392B; }
+.an-kpi-delta--neutral { color: var(--text-secondary); }
+
+/* ── Chart rows ───────────────────────────────────────────── */
+.an-row { margin-bottom: 16px; }
+.an-row--split {
+  display: grid;
+  grid-template-columns: 1.7fr 1fr;
+  gap: 16px;
+}
+.an-chart-body { padding-top: 4px; }
+.an-chart-body--donut { display: flex; flex-direction: column; align-items: center; }
+
+.an-legend {
+  list-style: none;
+  margin: 4px 0 0;
+  padding: 0;
+  width: 100%;
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+}
+.an-legend__item {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  padding: 6px 8px;
+  border-radius: 8px;
+  font-size: 12px;
+  color: var(--text-secondary);
+  transition: background 0.15s ease, padding-left 0.15s ease;
+}
+.an-legend__item:hover {
+  background: rgba(99, 102, 241, 0.08);
+  padding-left: 12px;
+  color: var(--text-primary);
+}
+.an-legend__dot { width: 9px; height: 9px; border-radius: 50%; flex: 0 0 auto; }
+.an-legend__label { flex: 1; }
+.an-legend__count { font-weight: 600; color: var(--text-primary); }
+
+/* ── Department TAT ──────────────────────────────────────── */
+.an-tat-card .lis-card__header { flex-wrap: wrap; row-gap: 8px; }
+.an-dept-filter { display: flex; gap: 6px; flex-wrap: wrap; margin-left: auto; }
+.an-dept-chip {
+  padding: 4px 11px;
+  min-height: 28px;
+  border-radius: 14px;
+  border: 0.5px solid var(--border-color);
+  background: var(--body-bg);
+  color: var(--text-secondary);
+  font-size: 11px;
+  font-weight: 500;
+  cursor: pointer;
+  transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
+}
+.an-dept-chip:hover { color: #4338CA; border-color: #6366F1; background: rgba(99,102,241,0.08); }
+.an-dept-chip--active {
+  color: var(--lis-primary-deep, #0F6E56);
+  border-color: var(--lis-primary, #3DC9A8);
+  background: var(--lis-primary-xlight, #E1F5EE);
+}
+
+.an-tat-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; }
+.an-tat-row {
+  display: grid;
+  grid-template-columns: 160px 1fr 150px;
+  align-items: center;
+  gap: 14px;
+  padding: 6px 8px;
+  border-radius: 8px;
+  transition: background 0.15s ease;
+}
+.an-tat-row:hover { background: var(--body-bg); }
+.an-tat-name { font-size: 13px; font-weight: 500; color: var(--text-primary); display: flex; flex-direction: column; gap: 2px; }
+.an-tat-samples { font-size: 10.5px; font-weight: 400; color: var(--text-secondary); }
+.an-tat-bar { position: relative; height: 8px; border-radius: 6px; background: var(--body-bg); overflow: visible; }
+.an-tat-bar__fill { height: 100%; border-radius: 6px; background: var(--lis-primary, #3DC9A8); transition: width 0.4s cubic-bezier(0.4,0,0.2,1); }
+.an-tat-bar__fill--over { background: #E24B4A; }
+.an-tat-bar__target { position: absolute; top: -3px; width: 2px; height: 14px; background: var(--text-secondary); opacity: 0.5; }
+.an-tat-value { font-size: 12px; color: var(--text-primary); font-weight: 600; text-align: right; }
+.an-tat-value--over { color: #C0392B; }
+.an-tat-target { font-weight: 400; color: var(--text-secondary); }
+.an-empty { padding: 20px; text-align: center; color: var(--text-secondary); font-size: 12.5px; }
+
+/* ── Tables ──────────────────────────────────────────────── */
+.an-table-wrap { overflow-x: auto; }
+.an-table { width: 100%; border-collapse: collapse; font-size: 12.5px; }
+.an-table thead th {
+  text-align: left;
+  padding: 10px 20px;
+  font-size: 10.5px;
+  text-transform: uppercase;
+  letter-spacing: 0.03em;
+  color: var(--text-secondary);
+  border-bottom: 0.5px solid var(--border-color);
+  white-space: nowrap;
+}
+.an-table tbody td {
+  padding: 11px 20px;
+  border-bottom: 0.5px solid var(--border-color);
+  color: var(--text-primary);
+}
+.an-table__row {
+  position: relative;
+  transition: background 0.15s ease;
+}
+.an-table__row::before {
+  content: '';
+  position: absolute;
+  left: 0; top: 0; bottom: 0;
+  width: 3px;
+  background: var(--lis-primary, #3DC9A8);
+  transform: scaleY(0);
+  transition: transform 0.15s ease;
+}
+.an-table__row:hover { background: rgba(99, 102, 241, 0.06); }
+.an-table__row:hover::before { transform: scaleY(1); }
+.an-table__row:last-child td { border-bottom: none; }
+.an-table__primary { font-weight: 500; display: flex; flex-direction: column; gap: 2px; }
+.an-table__sub { font-weight: 400; font-size: 11px; color: var(--text-secondary); }
+
+.an-change { display: inline-flex; align-items: center; gap: 2px; font-weight: 600; font-size: 11.5px; }
+.an-change--up   { color: #0F6E56; }
+.an-change--down { color: #C0392B; }
+
+/* ── Responsive ──────────────────────────────────────────── */
+@media (max-width: 1180px) {
+  .an-kpi-grid { grid-template-columns: repeat(3, 1fr); }
+  .an-row--split { grid-template-columns: 1fr; }
+}
+
+@media (max-width: 720px) {
+  .an-kpi-grid { grid-template-columns: repeat(2, 1fr); }
+  .page-header-actions { flex-wrap: wrap; }
+  .an-tat-row { grid-template-columns: 1fr; gap: 6px; }
+  .an-tat-value { text-align: left; }
+  .an-range-bar { gap: 6px; }
+  .an-chip { padding: 6px 12px; font-size: 12px; }
+}
+
+@media (max-width: 480px) {
+  .an-kpi-grid { grid-template-columns: 1fr; }
+}
diff --git a/src/app/features/analytics/analytics.component.html b/src/app/features/analytics/analytics.component.html
new file mode 100644
index 0000000..ddd6c07
--- /dev/null
+++ b/src/app/features/analytics/analytics.component.html
@@ -0,0 +1,226 @@
+<div class="page-header">
+  <div>
+    <h1 class="page-title">Analytics</h1>
+    <nav aria-label="Breadcrumb"><ol class="breadcrumb">
+      <li><a routerLink="/dashboard/home">Home</a></li>
+      <li aria-current="page">Analytics</li>
+    </ol></nav>
+  </div>
+  <div class="page-header-actions">
+    <button type="button" class="lis-btn lis-btn--secondary lis-btn--sm" (click)="data.refresh()">
+      <i class="ti ti-refresh" aria-hidden="true"></i> Refresh
+    </button>
+    <button type="button" class="lis-btn lis-btn--primary lis-btn--sm">
+      <i class="ti ti-download" aria-hidden="true"></i> Export report
+    </button>
+  </div>
+</div>
+
+<!-- Date range filter chips -->
+<div class="an-range-bar" role="tablist" aria-label="Date range">
+  @for (opt of rangeOptions; track opt.id) {
+    <button
+      type="button"
+      role="tab"
+      class="an-chip"
+      [class.an-chip--active]="activeRange(opt.id)"
+      [attr.aria-selected]="activeRange(opt.id)"
+      (click)="selectRange(opt.id)"
+    >
+      {{ opt.label }}
+    </button>
+  }
+  <span class="an-range-bar__spacer"></span>
+  <div class="an-collect" [class.an-collect--loading]="data.loading()">
+    <i class="ti ti-wallet" aria-hidden="true"></i>
+    <span>Collection rate <strong>{{ data.collectionRatePct() }}%</strong></span>
+    <span class="an-collect__sep">·</span>
+    <span>Dues <strong class="an-collect__dues">{{ data.outstandingDues() }}</strong></span>
+  </div>
+</div>
+
+<!-- KPI row -->
+<section class="an-kpi-grid" aria-label="Key metrics" [class.an-fade]="data.loading()">
+  @for (k of data.kpis(); track k.id) {
+    <div class="an-kpi-card">
+      <div class="an-kpi-top">
+        <div class="an-kpi-icon" [ngClass]="'an-kpi-icon--' + k.variant" aria-hidden="true">
+          <i class="ti ti-{{ k.icon }}"></i>
+        </div>
+        <div class="an-kpi-body">
+          <div class="an-kpi-label">{{ k.label }}</div>
+          <div class="an-kpi-value">{{ k.value }}</div>
+        </div>
+        <svg class="an-kpi-spark" [ngClass]="'an-kpi-spark--' + k.variant" viewBox="0 0 100 32" preserveAspectRatio="none" aria-hidden="true">
+          <polyline [attr.points]="k.spark" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
+        </svg>
+      </div>
+      <div class="an-kpi-delta" [ngClass]="'an-kpi-delta--' + k.deltaType">{{ k.delta }}</div>
+    </div>
+  }
+</section>
+
+<!-- Trend + status breakdown -->
+<div class="an-row an-row--split" [class.an-fade]="data.loading()">
+  <div class="lis-card an-chart-card">
+    <div class="lis-card__header">
+      <i class="ti ti-chart-area-line lis-card-icon" aria-hidden="true"></i>
+      <h2 class="lis-card__title">Revenue &amp; volume trend</h2>
+    </div>
+    <div class="lis-card__body an-chart-body">
+      <apx-chart
+        [series]="trendSeries()"
+        [chart]="trendChart"
+        [xaxis]="{ categories: trendCategories(), labels: { style: { fontSize: '11px' } } }"
+        [yaxis]="trendYaxis"
+        [stroke]="trendStroke"
+        [fill]="trendFill"
+        [grid]="trendGrid"
+        [dataLabels]="trendDataLabels"
+        [tooltip]="trendTooltip"
+        [colors]="trendColors"
+        [legend]="trendLegend"
+      ></apx-chart>
+    </div>
+  </div>
+
+  <div class="lis-card an-chart-card an-chart-card--donut">
+    <div class="lis-card__header">
+      <i class="ti ti-chart-donut lis-card-icon" aria-hidden="true"></i>
+      <h2 class="lis-card__title">Sample status</h2>
+      <span class="lis-badge">{{ data.totalSamplesInStatus() }} total</span>
+    </div>
+    <div class="lis-card__body an-chart-body an-chart-body--donut">
+      <apx-chart
+        [series]="statusSeries()"
+        [chart]="statusChart"
+        [labels]="statusLabels()"
+        [colors]="statusColors()"
+        [legend]="statusLegend"
+        [dataLabels]="statusDataLabels"
+        [plotOptions]="statusPlotOptions"
+      ></apx-chart>
+      <ul class="an-legend">
+        @for (s of data.statusBreakdown(); track s.status) {
+          <li class="an-legend__item">
+            <span class="an-legend__dot" [style.background]="s.color"></span>
+            <span class="an-legend__label">{{ s.label }}</span>
+            <span class="an-legend__count">{{ s.count }}</span>
+          </li>
+        }
+      </ul>
+    </div>
+  </div>
+</div>
+
+<!-- Department TAT -->
+<div class="an-row" [class.an-fade]="data.loading()">
+  <div class="lis-card an-tat-card">
+    <div class="lis-card__header">
+      <i class="ti ti-clock-hour-4 lis-card-icon" aria-hidden="true"></i>
+      <h2 class="lis-card__title">Turnaround time by department</h2>
+      @if (data.departmentsOverTarget() > 0) {
+        <span class="lis-badge lis-badge--danger">{{ data.departmentsOverTarget() }} over target</span>
+      }
+      <div class="an-dept-filter">
+        <button type="button" class="an-dept-chip" [class.an-dept-chip--active]="data.departmentFilter() === 'all'" (click)="selectDepartment('all')">All</button>
+        @for (d of data.allDepartments(); track d.id) {
+          <button
+            type="button"
+            class="an-dept-chip"
+            [class.an-dept-chip--active]="data.departmentFilter() === d.id"
+            (click)="selectDepartment(d.id)"
+          >{{ d.department }}</button>
+        }
+      </div>
+    </div>
+    <div class="lis-card__body">
+      <ul class="an-tat-list">
+        @for (d of data.departmentTat(); track d.id) {
+          <li class="an-tat-row">
+            <div class="an-tat-name">
+              {{ d.department }}
+              <span class="an-tat-samples">{{ d.samples }} samples</span>
+            </div>
+            <div class="an-tat-bar">
+              <div
+                class="an-tat-bar__fill"
+                [class.an-tat-bar__fill--over]="tatFlag(d.avgHours, d.targetHours) === 'over'"
+                [style.width.%]="tatPct(d.avgHours, d.targetHours)"
+              ></div>
+              <div class="an-tat-bar__target" [style.left.%]="tatPct(d.targetHours, d.targetHours) / 1.4"></div>
+            </div>
+            <div class="an-tat-value" [class.an-tat-value--over]="tatFlag(d.avgHours, d.targetHours) === 'over'">
+              {{ d.avgHours }}h <span class="an-tat-target">/ {{ d.targetHours }}h target</span>
+            </div>
+          </li>
+        }
+        @if (data.departmentTat().length === 0) {
+          <li class="an-empty">No department matches this filter.</li>
+        }
+      </ul>
+    </div>
+  </div>
+</div>
+
+<!-- Top tests + top doctors -->
+<div class="an-row an-row--split" [class.an-fade]="data.loading()">
+  <div class="lis-card">
+    <div class="lis-card__header">
+      <i class="ti ti-flask lis-card-icon" aria-hidden="true"></i>
+      <h2 class="lis-card__title">Top tests ordered</h2>
+    </div>
+    <div class="an-table-wrap">
+      <table class="an-table">
+        <thead>
+          <tr><th>Test</th><th>Orders</th><th>Revenue</th><th>Change</th></tr>
+        </thead>
+        <tbody>
+          @for (t of data.topTests(); track t.id) {
+            <tr class="an-table__row">
+              <td class="an-table__primary">{{ t.name }}</td>
+              <td>{{ t.orders }}</td>
+              <td>{{ t.revenue }}</td>
+              <td>
+                <span class="an-change" [class.an-change--up]="t.changePercent >= 0" [class.an-change--down]="t.changePercent < 0">
+                  {{ t.changePercent >= 0 ? '↑' : '↓' }} {{ Math.abs(t.changePercent) }}%
+                </span>
+              </td>
+            </tr>
+          }
+        </tbody>
+      </table>
+    </div>
+  </div>
+
+  <div class="lis-card">
+    <div class="lis-card__header">
+      <i class="ti ti-stethoscope lis-card-icon" aria-hidden="true"></i>
+      <h2 class="lis-card__title">Top referring doctors</h2>
+    </div>
+    <div class="an-table-wrap">
+      <table class="an-table">
+        <thead>
+          <tr><th>Doctor</th><th>Referrals</th><th>Revenue</th><th>Change</th></tr>
+        </thead>
+        <tbody>
+          @for (doc of data.topDoctors(); track doc.id) {
+            <tr class="an-table__row">
+              <td class="an-table__primary">
+                {{ doc.name }}
+                <span class="an-table__sub">{{ doc.clinic }}</span>
+              </td>
+              <td>{{ doc.referrals }}</td>
+              <td>{{ doc.revenue }}</td>
+              <td>
+                <span class="an-change" [class.an-change--up]="doc.changePercent >= 0" [class.an-change--down]="doc.changePercent < 0">
+                  {{ doc.changePercent >= 0 ? '↑' : '↓' }} {{ Math.abs(doc.changePercent) }}%
+                </span>
+              </td>
+            </tr>
+          }
+        </tbody>
+      </table>
+    </div>
+  </div>
+</div>
diff --git a/src/app/features/analytics/analytics.component.ts b/src/app/features/analytics/analytics.component.ts
index a2b35f6..24df03b 100644
