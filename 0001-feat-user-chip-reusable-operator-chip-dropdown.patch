@@ -0,0 +1,274 @@
+/* ══════════════════════════════════════════════════════
+   USER CHIP — operator identity + account dropdown
+   Two surfaces via .variant-sidebar; both reuse the app's
+   existing --lis-* / --text-* / --border-color tokens so
+   light/dark theme switching and the sidebar's fixed-dark
+   look keep working automatically.
+   ══════════════════════════════════════════════════════ */
+
+.chip-root {
+  --chip-hover-bg:   var(--lis-primary-xlight);
+  --chip-border:     var(--border-color);
+  --chip-name:       var(--text-primary);
+  --chip-role:       var(--text-secondary);
+  --chip-chevron:    var(--text-secondary);
+  --chip-ring-color: var(--card-bg);
+
+  position: relative;
+  display: inline-block;
+}
+
+.chip-root.variant-sidebar {
+  --chip-hover-bg:   rgba(255, 255, 255, 0.07);
+  --chip-border:     transparent;
+  --chip-name:       rgba(225, 233, 255, 0.90);
+  --chip-role:       rgba(160, 175, 215, 0.48);
+  --chip-chevron:    rgba(160, 175, 215, 0.55);
+  --chip-ring-color: #111827;
+
+  display: block;
+  width: 100%;
+}
+
+/* ── Trigger ─────────────────────────────────────────── */
+.chip-trigger {
+  display: flex;
+  align-items: center;
+  gap: 9px;
+  width: 100%;
+  background: none;
+  border: 1.5px solid transparent;
+  padding: 5px 10px 5px 5px;
+  border-radius: 30px;
+  cursor: pointer;
+  color: var(--chip-name);
+  text-align: left;
+  transition: background 0.18s ease, border-color 0.18s ease, transform 0.12s ease;
+}
+
+.variant-sidebar .chip-trigger {
+  border-radius: 10px;
+  padding: 8px 10px;
+}
+
+.chip-trigger:hover {
+  background: var(--chip-hover-bg);
+  border-color: var(--chip-border);
+}
+
+.chip-trigger:active {
+  transform: scale(0.97);
+}
+
+.chip-trigger.open {
+  background: var(--chip-hover-bg);
+  border-color: var(--chip-border);
+}
+
+.chip-trigger:focus-visible {
+  outline: 2px solid var(--lis-primary);
+  outline-offset: 2px;
+}
+
+/* ── Avatar ──────────────────────────────────────────── */
+.chip-avatar {
+  position: relative;
+  width: 32px;
+  height: 32px;
+  border-radius: 50%;
+  flex-shrink: 0;
+  background: linear-gradient(135deg, var(--lis-primary) 0%, #6366f1 100%);
+  color: #fff;
+  font-size: 11px;
+  font-weight: 700;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  box-shadow: 0 2px 8px rgba(61, 201, 168, 0.32);
+  transition: box-shadow 0.18s ease, transform 0.18s ease;
+}
+
+.chip-trigger:hover .chip-avatar {
+  box-shadow: 0 3px 14px rgba(61, 201, 168, 0.55);
+  transform: translateY(-1px);
+}
+
+.chip-status-dot {
+  position: absolute;
+  right: -1px;
+  bottom: -1px;
+  width: 9px;
+  height: 9px;
+  border-radius: 50%;
+  background: #22c55e;
+  border: 2px solid var(--chip-ring-color);
+}
+
+/* ── Name / role ─────────────────────────────────────── */
+.chip-text {
+  flex-direction: column;
+  min-width: 0;
+  line-height: 1.25;
+}
+
+.chip-name {
+  font-size: 12.5px;
+  font-weight: 700;
+  color: var(--chip-name);
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  max-width: 130px;
+}
+
+.chip-role {
+  font-size: 10.5px;
+  color: var(--chip-role);
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  max-width: 130px;
+}
+
+.chip-chevron {
+  font-size: 13px;
+  color: var(--chip-chevron);
+  margin-left: 2px;
+  flex-shrink: 0;
+  transition: transform 0.2s ease;
+}
+
+.chip-trigger.open .chip-chevron {
+  transform: rotate(180deg);
+}
+
+/* ── Dropdown panel ──────────────────────────────────── */
+.chip-menu {
+  position: absolute;
+  top: calc(100% + 8px);
+  right: 0;
+  min-width: 232px;
+  background: var(--card-bg);
+  border: 1px solid var(--border-color);
+  border-radius: 12px;
+  padding: 8px;
+  box-shadow: 0 16px 36px rgba(15, 23, 42, 0.16), 0 2px 8px rgba(15, 23, 42, 0.06);
+  z-index: 80;
+  animation: chipMenuIn 0.16s ease-out;
+}
+
+.chip-menu.align-left {
+  right: auto;
+  left: 0;
+}
+
+.chip-menu.place-up {
+  top: auto;
+  bottom: calc(100% + 8px);
+}
+
+@keyframes chipMenuIn {
+  from { opacity: 0; transform: translateY(-6px) scale(0.97); }
+  to   { opacity: 1; transform: translateY(0) scale(1); }
+}
+
+.chip-menu-header {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  padding: 8px 8px 10px;
+}
+
+.chip-menu-avatar {
+  width: 36px;
+  height: 36px;
+  border-radius: 50%;
+  flex-shrink: 0;
+  background: linear-gradient(135deg, var(--lis-primary) 0%, #6366f1 100%);
+  color: #fff;
+  font-size: 12px;
+  font-weight: 700;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+}
+
+.chip-menu-id { min-width: 0; }
+
+.chip-menu-name {
+  font-size: 13px;
+  font-weight: 700;
+  color: var(--text-primary);
+  margin: 0;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.chip-menu-lab {
+  font-size: 11px;
+  color: var(--text-secondary);
+  margin: 0;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.chip-menu-sep {
+  height: 1px;
+  background: var(--border-color);
+  margin: 4px 2px;
+}
+
+.chip-menu-item {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  width: 100%;
+  padding: 9px 10px;
+  border-radius: 8px;
+  border: none;
+  background: none;
+  cursor: pointer;
+  font-size: 13px;
+  font-weight: 500;
+  color: var(--text-primary);
+  text-decoration: none;
+  transition: background 0.12s ease, transform 0.08s ease;
+}
+
+.chip-menu-item i {
+  font-size: 15px;
+  width: 16px;
+  text-align: center;
+  color: var(--text-secondary);
+}
+
+.chip-menu-item:hover {
+  background: var(--lis-primary-xlight);
+}
+
+.chip-menu-item:active {
+  transform: scale(0.98);
+}
+
+.chip-menu-item:focus-visible {
+  outline: 2px solid var(--lis-primary);
+  outline-offset: -2px;
+}
+
+.chip-menu-item.danger { color: var(--lis-danger); }
+.chip-menu-item.danger i { color: var(--lis-danger); }
+.chip-menu-item.danger:hover { background: var(--lis-danger-xlight); }
+
+/* ── Responsive ──────────────────────────────────────── */
+@media (max-width: 640px) {
+  .chip-menu {
+    min-width: 210px;
+    right: -8px;
+  }
+  .chip-menu.align-left {
+    right: auto;
+    left: -8px;
+  }
+}
