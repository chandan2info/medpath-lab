+/* ══════════════════════════════════════════════════════
+   AGE CARD — read-only "computed status widget" for the
+   auto-calculated Age field. Spans 2 grid columns so the
+   Years / Months / Days segments have room to breathe.
+   ══════════════════════════════════════════════════════ */
+.age-field { grid-column: span 2; }
+@media (max-width: 860px) { .age-field { grid-column: span 2; } }
+@media (max-width: 560px) { .age-field { grid-column: span 1; } }
+
+/* Header row — label + AUTO pill grouped together immediately
+   above the card (was floating disconnected before). */
+.age-header {
   display: flex;
   align-items: center;
+  justify-content: space-between;
+  gap: 8px;
 }
-
-.auto-field {
-  width: 100%;
-  height: 38px;
-  padding: 0 32px 0 11px;
-  border: 1px dashed var(--border-color);
-  border-radius: 8px;
-  font-size: 13px;
+.age-header #age-label {
+  font-size: 12px;
+  color: var(--text-secondary);
   font-weight: 500;
-  color: var(--lis-primary-deep, #085041);
-  background: var(--lis-primary-xlight, #E1F5EE) !important;
-  font-family: var(--font-family);
-  cursor: default;
-  outline: none;
+}
 
-  &::placeholder {
-    color: var(--text-secondary);
-    font-weight: 400;
-    font-style: italic;
-    font-size: 12px;
+.age-card {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  /* -8px vertical padding vs. the previous version for a denser,
+     more enterprise-density row; the bigger numbers below still
+     read as prominent because of the extra internal gap. */
+  padding: 8px 14px;
+  border: 1px solid var(--border-color);
+  border-radius: 10px;
+  /* Card should feel elevated over the form background rather
+     than blending into it — a touch brighter than --card-bg. */
+  background: var(--card-bg);
+}
+@supports (background: color-mix(in srgb, red, blue)) {
+  .age-card {
+    background: color-mix(in srgb, var(--card-bg) 97%, var(--text-primary) 3%);
   }
 }
 
-.auto-field-lock {
-  position: absolute;
-  right: 10px;
-  font-size: 13px;
-  color: var(--lis-primary-mid, #5DCAA5);
-  pointer-events: none;
+.age-card__icon {
+  flex-shrink: 0;
+  width: 28px;
+  height: 28px;
+  border-radius: 50%;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  background: var(--lis-primary-xlight, #E1F5EE);
+  i { font-size: 13px; color: var(--lis-primary, #1D9E75); }
+}
+
+.age-card__body {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  flex: 1;
+}
+
+.age-card__segment {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  /* More breathing room between the number and its label. */
+  gap: 8px;
+  min-width: 46px;
+}
+
+.age-card__value {
+  font-size: 32px;
+  font-weight: 700;
+  line-height: 1;
+  font-variant-numeric: tabular-nums;
+}
+/* Years stays the strongest / most saturated colour since it's
+   the primary read; months is a visibly softer purple so the
+   eye doesn't bounce equally between all three. */
+.age-card__value--years   { color: #4F9DFF; }
+.age-card__value--months  { color: #A78BFA; }
+.age-card__value--days    { color: #FBBF24; }
+.age-card__value--placeholder { color: var(--text-secondary); font-weight: 600; }
+
+.age-card__unit {
+  font-size: 12px;
+  font-weight: 500;
+  color: var(--text-primary);
+  opacity: 0.6;
+  letter-spacing: 0.02em;
+}
+
+/* Restart the recalculation animation every time DOB changes —
+   Angular only replays a CSS animation when a class is actually
+   toggled, so ageTick flips between these two identical classes. */
+.age-tick-a, .age-tick-b { animation: age-card-pulse 0.25s ease; }
+@keyframes age-card-pulse {
+  from { opacity: 0.45; }
+  to   { opacity: 1; }
+}
+
+.age-card__divider {
+  width: 1px;
+  align-self: stretch;
+  margin: 2px 0;
+  /* Was barely visible at ~10% contrast; bumped up so the eye
+     can actually use it to scan between segments. */
+  background: var(--border-strong, var(--border-color));
+  opacity: 0.55;
+  flex-shrink: 0;
+}
+[data-theme="dark"] .age-card__divider { background: rgba(255,255,255,0.18); opacity: 1; }
+
+.age-card__divider--lock { margin: 4px 0; }
+
+/* Dedicated right-hand section for the read-only lock, separated
+   from the value segments by its own divider instead of floating
+   in a corner. */
+.age-card__lock-section {
+  flex-shrink: 0;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 4px;
+}
+
+.age-card__lock {
+  width: 26px;
+  height: 26px;
+  border-radius: 50%;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  background: var(--body-bg);
+  border: 1px solid var(--border-color);
+  cursor: help;
+  i { font-size: 12px; color: var(--text-secondary); }
 }
 
+.age-card__lock-label {
+  font-size: 9px;
+  font-weight: 500;
+  color: var(--text-secondary);
+  opacity: 0.75;
+  white-space: nowrap;
+}
+
+.age-card--empty {
+  background: var(--body-bg);
+  border-style: dashed;
+}
+
+.age-card__helper {
+  display: flex;
+  align-items: center;
+  gap: 5px;
+  i { font-size: 12px; color: var(--lis-primary, #1D9E75); }
+}
+
+/* Mobile — compact "19Y 11M 16D" rhythm; segments shrink and
+   dividers stay slim rather than wrapping the row. */
+@media (max-width: 560px) {
+  .age-card { padding: 6px 10px; gap: 8px; }
+  .age-card__body { gap: 6px; }
+  .age-card__segment { min-width: 36px; gap: 6px; }
+  .age-card__value { font-size: 24px; }
+  .age-card__unit { font-size: 10px; }
+  .age-card__icon { width: 24px; height: 24px; }
+  .age-card__icon i { font-size: 12px; }
+  .age-card__lock { width: 22px; height: 22px; }
+  .age-card__lock-label { display: none; }
+}
+
+
 /* ══════════════════════════════════════════════════════
    PHONE INPUT — +91 prefix
    ══════════════════════════════════════════════════════ */
