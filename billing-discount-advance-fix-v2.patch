 /* ── Discounts grid ──────────────────────── */
 .disc-group { padding: 4px 16px 14px; &:not(:last-child) { border-bottom: 0.5px solid var(--border-color); padding-bottom: 16px; } }
 .disc-group__label { font-size: 10px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--text-secondary); margin: 10px 0 10px; }
-.disc-group--advance { padding-top: 2px; }
 .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
-.form-grid--single { grid-template-columns: 1fr; max-width: 280px; }
 @media (max-width: 540px) { .form-grid { grid-template-columns: 1fr; } }
 
+/* Discounts / Advance side-by-side columns */
+.disc-groups-row { display: grid; grid-template-columns: 1fr 1fr; }
+.disc-groups-row .disc-group { padding: 4px 16px 14px; border-bottom: none; }
+.disc-groups-row .disc-group:first-child { border-right: 0.5px solid var(--border-color); }
+@media (max-width: 540px) {
+  .disc-groups-row { grid-template-columns: 1fr; }
+  .disc-groups-row .disc-group:first-child { border-right: none; border-bottom: 0.5px solid var(--border-color); }
+}
