+    /* Floating-label fields — pure CSS float via :not(:placeholder-shown) +
+       adjacent-sibling selector, no JS needed for the label animation. */
+    .lp-field { position:relative; margin-bottom:16px;
+      input {
+        width:100%; height:52px; border:1px solid var(--hero-border); border-radius:12px;
+        padding:20px 42px 6px 16px; font-size:14px; color:var(--hero-heading);
+        background:var(--card-bg); outline:none; font-family:inherit;
+        transition:border-color 0.15s;
+        &:focus { border-color:#1D9E75; }
+      }
+      label {
+        position:absolute; left:16px; top:16px; font-size:14px; color:var(--hero-body);
+        pointer-events:none; transition:all 0.15s ease;
+        transform-origin:left top;
+      }
+      input:focus + label,
+      input:not(:placeholder-shown) + label {
+        top:8px; font-size:11px; font-weight:500; color:#1D9E75;
+      }
+    }
+    .lp-field--error input { border-color:#DC2626; }
+    .lp-field--error label { color:#DC2626; }
+    .lp-field-icon { position:absolute; right:14px; top:14px; color:var(--hero-body); font-size:16px; background:none; border:none; cursor:default; padding:0; }
+    .lp-pw-eye { cursor:pointer; }
+    .lp-field-err { display:flex; align-items:center; gap:5px; font-size:11px; color:#DC2626; margin-top:5px; padding-left:2px; i { font-size:13px; flex-shrink:0; } }
+
+    .lp-remember-row { display:flex; align-items:center; justify-content:space-between; margin-bottom:18px; }
+    .lp-check { display:flex; align-items:center; gap:6px; font-size:13px; color:var(--hero-body); cursor:pointer; input { width:auto; height:auto; margin:0; } }
+    .lp-forgot { font-size:13px; color:#1D9E75; text-decoration:none; }
+
+    .lp-signin-btn {
+      width:100%; height:52px; background:linear-gradient(135deg,#1D9E75,#3DC9A8); color:#fff; border:none;
+      border-radius:12px; font-size:14px; font-weight:600; cursor:pointer; font-family:inherit;
+      display:flex; align-items:center; justify-content:center; gap:8px; position:relative;
+      &:hover:not(:disabled) { filter:brightness(1.06); }
+      &:disabled { cursor:default; }
+      .lp-btn-label { display:inline-flex; align-items:center; gap:8px; i { font-size:16px; } }
+      .lp-spinner { display:none; width:18px; height:18px; border-radius:50%; border:2px solid rgba(255,255,255,0.4); border-top-color:#fff; }
+      &.lp-signin-btn--loading {
+        .lp-btn-label { visibility:hidden; }
+        .lp-spinner { display:block; position:absolute; animation:lpSpin 0.7s linear infinite; }
+      }
+    }
+    .lp-secure-row { display:flex; align-items:center; justify-content:center; gap:6px; margin-top:14px; font-size:11px; color:var(--hero-body); i { font-size:13px; } }
+    .lp-demo-hint {
+      display:flex; align-items:center; justify-content:center; flex-wrap:wrap; gap:6px;
+      margin-top:8px; font-size:11px; color:#0F6E56;
+      background:var(--hero-primary-light); border:1px solid rgba(61,201,168,0.3);
+      border-radius:8px; padding:8px 12px; i { font-size:12px; flex-shrink:0; }
+    }
+    .lp-demo-badge {
+      font-family:monospace; font-size:11px; color:#0F6E56; background:rgba(29,158,117,0.14);
+      border:1px solid rgba(29,158,117,0.3); padding:2px 8px; border-radius:6px; cursor:pointer;
+      &:hover { background:rgba(29,158,117,0.22); }
+    }
+
+    @keyframes heroIn { from { opacity:0; transform:translateY(20px); } to { opacity:1; transform:translateY(0); } }
+    @keyframes cardIn { from { opacity:0; transform:scale(0.98); } to { opacity:1; transform:scale(1); } }
+    @keyframes lpSpin { to { transform:rotate(360deg); } }
+    @media (prefers-reduced-motion:reduce) {
+      .lp-hero-copy, .lp-login-card { animation:none; }
+      .lp-spinner { animation:none; }
+    }
 
     /* Sections */
     .lp-section    { padding:34px 28px; }
