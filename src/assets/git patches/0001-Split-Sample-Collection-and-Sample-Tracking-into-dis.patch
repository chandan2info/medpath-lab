diff --git a/src/app/features/sample-collection/sample-collection.component.css b/src/app/features/sample-collection/sample-collection.component.css
new file mode 100644
index 0000000..765a175
--- /dev/null
+++ b/src/app/features/sample-collection/sample-collection.component.css
@@ -0,0 +1,73 @@
+:host { display:block; }
+.page-header { display:flex; align-items:flex-start; justify-content:space-between; flex-wrap:wrap; gap:12px; margin-bottom:18px; }
+.page-title  { font-size:22px; font-weight:500; color:var(--text-primary); margin:0 0 4px; }
+.breadcrumb  { display:flex; list-style:none; padding:0; margin:0; gap:6px; font-size:12px; color:var(--text-secondary); }
+.breadcrumb a { color:var(--text-secondary); text-decoration:none; &:hover{color:var(--lis-primary,#1D9E75);} }
+.breadcrumb li+li::before { content:'/'; margin-right:6px; }
+
+/* ── Workflow trail ──────────────────────────── */
+.workflow-trail { display: flex; align-items: center; gap: 6px; background: var(--body-bg); border: 0.5px solid var(--border-color); border-radius: 9px; padding: 6px 12px; }
+.wf-step { display: flex; align-items: center; gap: 5px; font-size: 11px; color: var(--text-secondary); i { font-size: 13px; } }
+.wf-step--active { color: var(--lis-primary-deep, #085041); font-weight: 500; i { color: var(--lis-primary, #1D9E75); } }
+.wf-step--done   { color: var(--lis-primary, #1D9E75); font-weight: 500; i { color: var(--lis-primary, #1D9E75); } }
+.wf-arrow { font-size: 11px; color: var(--border-color); }
+
+/* ── Current patient block ──────────────────── */
+.current-patient-block { margin-bottom: 16px; }
+.cp-layout {
+  display: grid;
+  grid-template-columns: 220px 1fr 200px;
+  gap: 16px; padding: 14px 16px;
+  align-items: start;
+}
+@media (max-width: 900px) { .cp-layout { grid-template-columns: 1fr; } }
+.cp-patient { display: flex; flex-direction: column; gap: 8px; }
+.cp-av { width: 42px; height: 42px; border-radius: 50%; background: var(--lis-primary, #1D9E75); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 700; text-transform: uppercase; flex-shrink: 0; }
+.cp-info { }
+.cp-name { font-size: 14px; font-weight: 600; color: var(--text-primary); }
+.cp-meta { font-size: 11px; color: var(--text-secondary); margin-top: 3px; }
+.cp-priority { display: inline-flex; align-items: center; gap: 4px; margin-top: 6px; font-size: 11px; font-weight: 600; padding: 2px 9px; border-radius: 20px; background: var(--lis-primary-xlight, #E1F5EE); color: var(--lis-primary-deep, #085041); border: 0.5px solid var(--lis-primary-mid, #5DCAA5); text-transform: capitalize; }
+.cp-priority--stat { background: #FCEBEB; color: #791F1F; border-color: #E24B4A; }
+
+/* Tubes */
+.cp-tubes { display: flex; flex-direction: column; gap: 10px; }
+.cp-tube  {
+  display: flex; align-items: center; gap: 10px;
+  padding: 10px 12px; border: 0.5px solid var(--border-color);
+  border-radius: 10px; background: var(--body-bg);
+}
+.tube-body-wrap { display: flex; flex-direction: column; align-items: center; gap: 0; flex-shrink: 0; }
+.tube-body-cap  { width: 14px; height: 10px; border-radius: 4px 4px 0 0; }
+.tube-body-body { width: 10px; height: 30px; border-radius: 0 0 5px 5px; background: rgba(0,0,0,.06); border: 1px solid var(--border-color); }
+.tube-detail { flex: 1; min-width: 0; }
+.tube-label  { font-size: 12px; font-weight: 500; color: var(--text-primary); }
+.tube-tests  { font-size: 11px; color: var(--text-secondary); margin-top: 2px; }
+.tube-barcode { display: flex; flex-direction: column; align-items: center; gap: 3px; }
+.bc-bars { display:flex; gap:1px; height:20px; align-items:stretch; }
+.bc-bar  { border-radius:1px; background:var(--text-primary); }
+.bc-num  { font-size:11px; font-family:monospace; color:var(--text-secondary); }
+
+/* Collection form */
+.cp-form { display: flex; flex-direction: column; gap: 8px; }
+.collect-btn { width: 100%; justify-content: center; }
+.collected-confirm {
+  display: flex; align-items: center; gap: 8px;
+  padding: 10px 12px; background: var(--lis-primary-xlight, #E1F5EE);
+  border: 0.5px solid var(--lis-primary-mid, #5DCAA5);
+  border-radius: 9px; animation: fadeIn .3s ease;
+  i { font-size: 22px; color: var(--lis-primary, #1D9E75); }
+}
+.cc-title { font-size: 12px; font-weight: 600; color: var(--lis-primary-deep, #085041); }
+.cc-time  { font-size: 11px; color: var(--text-secondary); }
+.collected-badge { background: var(--lis-primary-xlight, #E1F5EE) !important; color: var(--lis-primary-deep, #085041) !important; border-color: var(--lis-primary-mid, #5DCAA5) !important; }
+@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
+
+/* ── Empty state (no active patient) ─────────── */
+.empty-state {
+  display: flex; flex-direction: column; align-items: center; text-align: center;
+  gap: 8px; padding: 48px 24px; color: var(--text-secondary);
+}
+.empty-icon  { font-size: 34px; color: var(--text-secondary); opacity: .6; margin-bottom: 4px; }
+.empty-title { font-size: 15px; font-weight: 600; color: var(--text-primary); margin: 0; }
+.empty-copy  { font-size: 12px; max-width: 380px; margin: 0 0 8px; }
+.empty-state .lis-btn { margin-top: 4px; }
