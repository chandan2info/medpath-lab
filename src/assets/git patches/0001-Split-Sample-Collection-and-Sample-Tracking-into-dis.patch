 .../sample-collection.component.html          | 148 ++++++++++++++++++
 .../sample-collection.component.ts            |  84 ++++++++++
 .../sample-tracking.component.css             |  58 -------
 .../sample-tracking.component.html            | 139 +---------------
 .../sample-tracking.component.ts              |  83 ++--------
 7 files changed, 322 insertions(+), 267 deletions(-)
