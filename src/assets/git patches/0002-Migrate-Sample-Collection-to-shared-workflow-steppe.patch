 .../sample-collection.component.html          | 22 ++++---------
 .../sample-collection.component.ts            | 18 ++++-------
 .../workflow-stepper.component.html           |  2 +-
 .../workflow-stepper.component.ts             |  3 ++
 5 files changed, 20 insertions(+), 57 deletions(-)

