 }
-.proc-step { display: flex; flex-direction: column; align-items: center; gap: 6px; flex-shrink: 0; width: 92px; }
-.proc-dot {
-  width: 30px; height: 30px; border-radius: 50%;
-  display: flex; align-items: center; justify-content: center;
-  font-size: 14px; color: var(--text-secondary);
-  background: var(--body-bg); border: 1.5px solid var(--border-color);
-  transition: background .2s, border-color .2s, color .2s, box-shadow .2s;
-}
-.proc-step--done .proc-dot {
-  background: var(--lis-primary, #1D9E75); border-color: var(--lis-primary, #1D9E75); color: #fff;
-}
-.proc-step--active .proc-dot {
-  background: var(--lis-primary-xlight, #E1F5EE); border-color: var(--lis-primary, #1D9E75);
-  color: var(--lis-primary-deep, #085041);
-  box-shadow: 0 0 0 4px var(--lis-primary-xlight, #E1F5EE);
-  animation: pulseDot 1.8s ease-in-out infinite;
-}
-@keyframes pulseDot {
-  0%, 100% { box-shadow: 0 0 0 4px var(--lis-primary-xlight, #E1F5EE); }
-  50%      { box-shadow: 0 0 0 7px var(--lis-primary-xlight, #E1F5EE); }
-}
-.proc-label { font-size: 10.5px; color: var(--text-secondary); text-align: center; white-space: nowrap; transition: color .2s; }
-.proc-step--done .proc-label, .proc-step--active .proc-label { color: var(--text-primary); font-weight: 500; }
-.proc-line { flex: 1; height: 1.5px; background: var(--border-color); margin: 15px -2px 0; min-width: 16px; transition: background .3s; }
-.proc-line--done { background: var(--lis-primary, #1D9E75); }
 
