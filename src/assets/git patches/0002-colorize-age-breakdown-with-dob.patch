diff --git a/src/styles.css b/src/styles.css
index 7769a9b..5093502 100644
--- a/src/styles.css
+++ b/src/styles.css
@@ -5348,3 +5348,15 @@
 .pat-detail-item { display: inline-flex; align-items: center; gap: 5px; font-size: 12px; color: var(--text-primary); }
 .pat-detail-icon { font-size: 13px; color: var(--lis-primary, #1D9E75); }
 .pat-detail-sep  { color: var(--border-color); font-size: 12px; }
+
+/* ══════════════════════════════════════════════════════════
+   AGE BREAKDOWN — colorized inline segments
+   Same palette as the "Age card" on Patient Registration
+   (years/months/days each get their own color), reused wherever
+   the compact "19y · 11m · 14d" breakdown appears in a patient
+   metadata row, with a teal separator to match the app accent.
+   ══════════════════════════════════════════════════════════ */
+.age-inline__y   { color: #4F9DFF; font-weight: 500; }
+.age-inline__m   { color: #A78BFA; font-weight: 500; }
+.age-inline__d   { color: #FBBF24; font-weight: 500; }
+.age-inline__sep { color: var(--lis-primary-mid, #5DCAA5); padding: 0 1px; }
