--- a/src/app/core/services/patient-flow.service.ts
+++ b/src/app/core/services/patient-flow.service.ts
@@ -178,4 +178,26 @@ export class PatientFlowService {
     if (today < new Date(today.getFullYear(), birth.getMonth(), birth.getDate())) age--;
     return age;
   }
+
+  /** Full years/months/days breakdown — e.g. { years: 19, months: 11, days: 16 }. */
+  calcAgeParts(dob: string): { years: number; months: number; days: number } {
+    if (!dob) return { years: 0, months: 0, days: 0 };
+    const today = new Date();
+    const birth = new Date(dob);
+
+    let years  = today.getFullYear() - birth.getFullYear();
+    let months = today.getMonth() - birth.getMonth();
+    let days   = today.getDate() - birth.getDate();
+
+    if (days < 0) {
+      months--;
+      const prevMonth = new Date(today.getFullYear(), today.getMonth(), 0);
+      days += prevMonth.getDate();
+    }
+    if (months < 0) {
+      years--;
+      months += 12;
+    }
+    return { years: Math.max(years, 0), months: Math.max(months, 0), days: Math.max(days, 0) };
+  }
 }
