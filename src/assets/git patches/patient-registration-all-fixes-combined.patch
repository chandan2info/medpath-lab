--- /dev/null
+++ b/src/app/shared/components/dob-date-picker/dob-date-picker.component.css
@@ -0,0 +1,185 @@
+:host { display: block; position: relative; }
+
+/* ══════════════════════════════════════════════════════
+   TRIGGER — replaces the native <input type="date">
+   ══════════════════════════════════════════════════════ */
+.dob-trigger {
+  width: 100%;
+  height: 38px;
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  padding: 0 11px;
+  border: 1px solid var(--border-color);
+  border-radius: 8px;
+  background: var(--card-bg);
+  color: var(--text-primary);
+  font-family: var(--font-family);
+  font-size: 13px;
+  cursor: pointer;
+  transition: border-color 0.15s, box-shadow 0.15s;
+}
+.dob-trigger:hover { border-color: var(--lis-primary-mid, #5DCAA5); }
+.dob-trigger--open,
+.dob-trigger:focus-visible {
+  outline: none;
+  border-color: var(--lis-primary, #1D9E75);
+  box-shadow: 0 0 0 3px var(--lis-primary-xlight, #E1F5EE);
+}
+.dob-trigger--error { border-color: #E8A5A4; box-shadow: 0 0 0 1px rgba(226,75,74,0.12); }
+.dob-trigger:disabled { opacity: 0.6; cursor: not-allowed; }
+
+.dob-trigger__icon { font-size: 15px; color: var(--lis-primary, #1D9E75); flex-shrink: 0; }
+.dob-trigger__text { flex: 1; text-align: left; }
+.dob-trigger__text--placeholder { color: var(--text-secondary); }
+.dob-trigger__chevron {
+  font-size: 13px;
+  color: var(--text-secondary);
+  transition: transform 0.15s;
+  flex-shrink: 0;
+}
+.dob-trigger--open .dob-trigger__chevron { transform: rotate(180deg); }
+
+/* ══════════════════════════════════════════════════════
+   PANEL — same corner radius / shadow language as the
+   app's cards & modals so it never looks like an OS widget.
+   Fully driven by CSS variables, so [data-theme="dark"] on
+   <html> re-themes it automatically, same as everything else.
+   ══════════════════════════════════════════════════════ */
+.dob-panel {
+  position: absolute;
+  top: calc(100% + 6px);
+  left: 0;
+  z-index: 50;
+  width: 300px;
+  padding: 14px;
+  background: var(--card-bg);
+  border: 1px solid var(--border-color);
+  border-radius: 16px;
+  box-shadow: var(--shadow-editor, 0 24px 64px rgba(0,0,0,0.18));
+  animation: dobPanelIn 0.15s ease;
+}
+@keyframes dobPanelIn {
+  from { opacity: 0; transform: translateY(-4px); }
+  to   { opacity: 1; transform: translateY(0); }
+}
+
+.dob-panel__header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 2px;
+  margin-bottom: 10px;
+}
+
+.dob-nav-btn {
+  width: 28px;
+  height: 28px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  border: none;
+  border-radius: 8px;
+  background: transparent;
+  color: var(--text-secondary);
+  cursor: pointer;
+  flex-shrink: 0;
+  transition: background 0.15s, color 0.15s;
+  i { font-size: 15px; }
+}
+.dob-nav-btn:hover { background: var(--lis-primary-xlight, #E1F5EE); color: var(--lis-primary-deep, #085041); }
+
+.dob-month-label {
+  flex: 1;
+  text-align: center;
+  font-size: 13px;
+  font-weight: 600;
+  color: var(--text-primary);
+  background: transparent;
+  border: none;
+  border-radius: 8px;
+  padding: 4px 6px;
+  cursor: pointer;
+}
+.dob-month-label:hover { background: var(--body-bg); }
+.dob-month-label--static { cursor: default; }
+.dob-month-label--static:hover { background: transparent; }
+
+.dob-weekdays {
+  display: grid;
+  grid-template-columns: repeat(7, 1fr);
+  margin-bottom: 4px;
+  span {
+    text-align: center;
+    font-size: 10px;
+    font-weight: 600;
+    color: var(--text-secondary);
+  }
+}
+
+.dob-grid {
+  display: grid;
+  grid-template-columns: repeat(7, 1fr);
+  gap: 2px;
+}
+
+.dob-day {
+  width: 100%;
+  aspect-ratio: 1;
+  min-height: 30px;
+  border: none;
+  border-radius: 8px;
+  background: transparent;
+  color: var(--text-primary);
+  font-size: 12px;
+  font-family: var(--font-family);
+  cursor: pointer;
+  transition: background 0.12s, color 0.12s;
+}
+.dob-day:hover:not(:disabled) { background: var(--body-bg); }
+.dob-day:focus-visible {
+  outline: none;
+  box-shadow: 0 0 0 2px var(--lis-primary, #1D9E75);
+}
+.dob-day--out { color: var(--text-secondary); opacity: 0.45; }
+.dob-day--today { font-weight: 700; color: var(--lis-primary, #1D9E75); }
+.dob-day--selected {
+  background: var(--lis-primary, #1D9E75);
+  color: #fff;
+  font-weight: 600;
+}
+.dob-day--selected:hover:not(:disabled) { background: var(--lis-primary, #1D9E75); }
+.dob-day:disabled { opacity: 0.25; cursor: not-allowed; }
+
+.dob-panel__hint {
+  margin-top: 10px;
+  font-size: 10px;
+  color: var(--text-secondary);
+  text-align: center;
+}
+
+/* ── Year / decade picker (10-year jump) ─────────────── */
+.dob-year-grid {
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+  gap: 6px;
+}
+.dob-year {
+  padding: 10px 4px;
+  border: 1px solid var(--border-color);
+  border-radius: 10px;
+  background: var(--body-bg);
+  color: var(--text-primary);
+  font-size: 13px;
+  font-family: var(--font-family);
+  cursor: pointer;
+  transition: background 0.12s, border-color 0.12s;
+}
+.dob-year:hover { border-color: var(--lis-primary-mid, #5DCAA5); }
+.dob-year--out { opacity: 0.5; }
+.dob-year--active {
+  background: var(--lis-primary, #1D9E75);
+  border-color: var(--lis-primary, #1D9E75);
+  color: #fff;
+  font-weight: 600;
+}
